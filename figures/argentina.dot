graph G {
  rankdir=LR; newrank=true; splines=true; nodesep=0.18; ranksep=0.9;
  fontname="Helvetica"; labelloc=t; fontsize=18;
  label="Argentina → United States: minimum cut = 5 cables";
  node [fontname="Helvetica", fontsize=12, penwidth=0.8];
  edge [penwidth=0.8];
  "R:Argentina" [label="Argentina", shape=box, style="rounded,filled,bold", fillcolor="#CECBF6", fontsize=14];
  "R:Brazil" [label="Brazil", shape=box, style="rounded,filled,bold", fillcolor="#E6F1FB", fontsize=14];
  "R:United States" [label="United States", shape=box, style="rounded,filled,bold", fillcolor="#CECBF6", fontsize=14];
  { rank=min; "R:Argentina"; }
  { rank=max; "R:United States"; }
  "C:america-movil-submarine-cable-system-1-amx-1" [label="AMX-1
+6", shape=box, fontsize=10, margin="0.08,0.03", style=filled, fillcolor="#F1EFE8"];
  "C:bicentenario" [label="Bicentenario
+1", shape=box, fontsize=10, margin="0.08,0.03", style=filled, fillcolor="#F1EFE8"];
  "C:brusa" [label="BRUSA
+1", shape=box, fontsize=10, margin="0.08,0.03", style=filled, fillcolor="#F1EFE8"];
  "C:firmina" [label="Firmina
+2", shape=box, fontsize=10, margin="0.08,0.03", style="filled,bold", fillcolor="#FCEBEB", color="#A32D2D", penwidth=1.6];
  "C:globenet" [label="GlobeNet
+3", shape=box, fontsize=10, margin="0.08,0.03", style=filled, fillcolor="#F1EFE8"];
  "C:malbec" [label="Malbec", shape=box, fontsize=10, margin="0.08,0.03", style="filled,bold", fillcolor="#FCEBEB", color="#A32D2D", penwidth=1.6];
  "C:south-america-1-sam-1" [label="SAm-1
+7", shape=box, fontsize=10, margin="0.08,0.03", style="filled,bold", fillcolor="#FCEBEB", color="#A32D2D", penwidth=1.6];
  "C:south-american-crossing-sac" [label="SAC
+6", shape=box, fontsize=10, margin="0.08,0.03", style="filled,bold", fillcolor="#FCEBEB", color="#A32D2D", penwidth=1.6];
  "C:tannat" [label="Tannat
+1", shape=box, fontsize=10, margin="0.08,0.03", style="filled,bold", fillcolor="#FCEBEB", color="#A32D2D", penwidth=1.6];
  "C:unisur" [label="Unisur
+1", shape=box, fontsize=10, margin="0.08,0.03", style=filled, fillcolor="#F1EFE8"];
  "R:Brazil" -- "C:america-movil-submarine-cable-system-1-amx-1" [color="#0F6E56", penwidth=2.4];
  "C:america-movil-submarine-cable-system-1-amx-1" -- "R:United States" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:bicentenario" [color="#B4B2A9", style=dashed];
  "R:Brazil" -- "C:brusa" [color="#0F6E56", penwidth=2.4];
  "C:brusa" -- "R:United States" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:firmina" [color="#0F6E56", penwidth=2.4];
  "C:firmina" -- "R:Brazil" [color="#B4B2A9", style=dashed, constraint=false];
  "C:firmina" -- "R:United States" [color="#0F6E56", penwidth=2.4];
  "R:Brazil" -- "C:globenet" [color="#0F6E56", penwidth=2.4];
  "C:globenet" -- "R:United States" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:malbec" [color="#0F6E56", penwidth=2.4];
  "C:malbec" -- "R:Brazil" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:south-america-1-sam-1" [color="#0F6E56", penwidth=2.4];
  "C:south-america-1-sam-1" -- "R:Brazil" [color="#B4B2A9", style=dashed, constraint=false];
  "C:south-america-1-sam-1" -- "R:United States" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:south-american-crossing-sac" [color="#0F6E56", penwidth=2.4];
  "C:south-american-crossing-sac" -- "R:Brazil" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:tannat" [color="#0F6E56", penwidth=2.4];
  "C:tannat" -- "R:Brazil" [color="#0F6E56", penwidth=2.4];
  "R:Argentina" -- "C:unisur" [color="#B4B2A9", style=dashed];
  legend [shape=plaintext, fontsize=10, label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT COLOR="#0F6E56"><B>━━</B></FONT> route that carries one unit of flow</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B4B2A9">╍╍</FONT> other landing of the cable</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#A32D2D"><B>▭</B></FONT> cable in the minimum cut</TD></TR><TR><TD ALIGN="LEFT">+k  landings in countries not drawn</TD></TR></TABLE>>];
  { rank=max; legend; }
}