graph G {
  rankdir=LR; newrank=true; splines=true; nodesep=0.18; ranksep=0.9;
  fontname="Helvetica"; labelloc=t; fontsize=18;
  label="Brazil → United States: minimum cut = 11 cables";
  node [fontname="Helvetica", fontsize=12, penwidth=0.8];
  edge [penwidth=0.8];
  "R:Angola" [label="Angola", shape=box, style="rounded,filled,bold", fillcolor="#E6F1FB", fontsize=14];
  "R:Brazil" [label="Brazil", shape=box, style="rounded,filled,bold", fillcolor="#CECBF6", fontsize=14];
